            VALUE "OriginalFilename", "@HIDFIDO_FILE_NAME@"
            VALUE "ProductName", "HID-FIDO2-WinLogon"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
